<Window x:Class="KinectV2MouseControl.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KinectV2MouseControl"
        Title="KINECT-OS widget"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding OverlayAlwaysOnTop}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <!-- The orb halo breathes while the pointer is live. -->
        <Style x:Key="Halo" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.6"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.4" Duration="0:0:1.6"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.4" Duration="0:0:1.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HandChip" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="20" Background="#EC0C1524"
                BorderThickness="1" Effect="{StaticResource Effect.WidgetShadow}"
                MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.SurfaceBorderStrong}"/>
                    <Style.Triggers>
                        <!-- The whole widget takes the voice colour while a wake cycle is on screen. -->
                        <DataTrigger Binding="{Binding Voice.HudVisible}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding Voice.HudState, Converter={StaticResource VoiceBrush}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="14,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status orb -->
                <Grid Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Halo}" Fill="{Binding Status.ControlState, Converter={StaticResource StateBrush}}"/>
                    <Ellipse Width="12" Height="12"
                             Fill="{Binding Status.ControlState, Converter={StaticResource StateBrush}}"
                             Effect="{Binding Status.ControlState, Converter={StaticResource StateGlow}}"/>
                    <Ellipse Width="22" Height="22" Stroke="{StaticResource Brush.SurfaceBorderStrong}" StrokeThickness="1"/>
                </Grid>

                <!-- Text: control status normally, the voice cycle while one is on screen -->
                <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="150" MaxWidth="220">
                    <StackPanel Visibility="{Binding Voice.HudVisible, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KINECT-OS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Engine.ActiveProfileName}" FontSize="9.5" Foreground="{StaticResource Brush.TextMuted}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status.Headline}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status.Subline}" FontSize="11" Foreground="{StaticResource Brush.TextDim}"
                                   FontFamily="{StaticResource Font.Text}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Voice.HudVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="KINECT" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{Binding Voice.HudState, Converter={StaticResource VoiceBrush}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Style="{StaticResource VoicePulseDot}" Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center"
                                     Fill="{Binding Voice.HudState, Converter={StaticResource VoiceBrush}}"
                                     Effect="{Binding Voice.HudState, Converter={StaticResource VoiceGlow}}"/>
                            <TextBlock Text="{Binding Voice.HudText}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Voice.HudDetail}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}"
                                   FontFamily="{StaticResource Font.Text}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Hands + voice -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                    <Border Style="{StaticResource HandChip}" ToolTip="Left hand: in zone / fist = clutch"
                            Background="{Binding Status.LeftHandInZone, Converter={StaticResource OnSoftBrush}}"
                            BorderBrush="{Binding Status.IsClutchArmed, Converter={StaticResource OnBorderBrush}}">
                        <local:IconView Icon="{StaticResource IconHandLeft}" Size="15"
                                        Foreground="{Binding Status.LeftHandInZone, Converter={StaticResource OnBrush}}"/>
                    </Border>
                    <Border Style="{StaticResource HandChip}" ToolTip="Right hand: pointing / fist = grip"
                            Background="{Binding Status.IsPointerActive, Converter={StaticResource OnSoftBrush}}"
                            BorderBrush="{Binding Status.IsGripHeld, Converter={StaticResource OnBorderBrush}}">
                        <local:IconView Icon="{StaticResource IconGestures}" Size="15"
                                        Foreground="{Binding Status.IsPointerActive, Converter={StaticResource OnBrush}}"/>
                    </Border>
                    <Border Style="{StaticResource HandChip}" ToolTip="{Binding Voice.StatusText}"
                            Background="{Binding Voice.IsListening, Converter={StaticResource OnSoftBrush}}"
                            BorderBrush="{Binding Voice.IsCommandWindowOpen, Converter={StaticResource OnBorderBrush}}">
                        <local:IconView Icon="{StaticResource IconVoice}" Size="14"
                                        Foreground="{Binding Voice.IsListening, Converter={StaticResource OnBrush}}"
                                        Effect="{Binding Voice.IsCommandWindowOpen, Converter={StaticResource OnGlow}}"/>
                    </Border>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Width="30" Height="30" Click="Power_Click"
                            ToolTip="Switch Kinect control on / off"
                            Foreground="{Binding Status.IsControlEnabled, Converter={StaticResource GoodBrush}}">
                        <local:IconView Icon="{StaticResource IconPower}" Size="14"/>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Width="30" Height="30" Margin="4,0,0,0" Click="Expand_Click"
                            ToolTip="Open the control center">
                        <local:IconView Icon="{StaticResource IconExpand}" Size="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
