<Window x:Class="KinectV2MouseControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:KinectV2MouseControl"
        Title="KINECT-OS"
        Width="1240" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False" CornerRadius="0" NonClientFrameEdges="None"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One nav entry: icon, title, subtitle, optional badge. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:IconView Icon="{Binding IconKey, Converter={StaticResource IconKey}}" Size="19" Margin="2,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                               FontFamily="{StaticResource Font.Text}"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="7,2" Margin="8,0,0,0"
                        Background="{StaticResource Brush.AccentFaint}" BorderBrush="{StaticResource Brush.AccentSoft}"
                        Visibility="{Binding Badge, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Badge}" Style="{StaticResource Pill.Text}" FontSize="9.5"
                               Foreground="{StaticResource Brush.Accent}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="HeaderPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- Width 0 when closed, 340 when open. The Setter is what the offscreen smoke test
             renders. PanelSlide animates only on a shown window, and always with both From
             and To: a To-only DoubleAnimation throws if it is sampled during a resize
             before its origin can be read. -->
        <Style x:Key="HelpDrawerStyle" TargetType="Border">
            <Setter Property="Width" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHelpOpen}" Value="True">
                    <Setter Property="Width" Value="340"/>
                    <Setter Property="local:PanelSlide.ToWidth" Value="340"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HelpLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="Margin" Value="0,14,0,3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Base: painted background (opaque fallback, or a translucent tint over acrylic). -->
        <Border x:Name="Backdrop" Background="{StaticResource Brush.BackdropOpaque}"/>
        <Border Background="{StaticResource Brush.Bloom}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ Navigation rail ============================ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Rail}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,0">
                <Grid Margin="14,0,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand. Sits inside the caption band, so it also drags the window. -->
                    <Grid Grid.Row="0" Height="52" Margin="6,8,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="34" Margin="0,0,12,0">
                                <Ellipse Stroke="{StaticResource Brush.Accent}" StrokeThickness="2.2"
                                         Effect="{StaticResource Effect.AccentGlowSoft}"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Accent}"
                                         Effect="{StaticResource Effect.AccentGlow}"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="KINECT-OS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock Text="SPATIAL CONTROL CENTER" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource Nav.List}"
                             ItemContainerStyle="{StaticResource Nav.Item}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"/>

                    <!-- Rail footer: live state + compact mode. -->
                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource CardInset}" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Fill="{Binding Status.ControlState, Converter={StaticResource StateBrush}}"
                                         Effect="{Binding Status.ControlState, Converter={StaticResource StateGlow}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Status.Headline}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Engine.ActiveProfileName}" Style="{StaticResource Text.Caption}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding EnterCompactCommand}"
                                HorizontalContentAlignment="Stretch" ToolTip="Hide the control center and show the floating status widget">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Icon="{StaticResource IconCompact}" Size="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Compact mode"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Main column ============================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header lives in the caption band; interactive children opt out of drag. -->
                <Grid Grid.Row="0" Margin="24,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Text.Caption}" Margin="10,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Style="{StaticResource HeaderPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Margin="0,0,7,0"
                                         Fill="{Binding Status.IsSensorConnected, Converter={StaticResource GoodBrush}}"/>
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.SensorText, StringFormat=Kinect {0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HeaderPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Margin="0,0,7,0"
                                         Fill="{Binding Status.IsTracking, Converter={StaticResource GoodBrush}}"/>
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.TrackingText}"/>
                            </StackPanel>
                        </Border>
                        <!-- Voice wake cycle: only on screen from "Kinect" until the outcome fades. -->
                        <Border Style="{StaticResource HeaderPill}"
                                Background="{Binding Voice.HudState, Converter={StaticResource VoiceSoftBrush}}"
                                BorderBrush="{Binding Voice.HudState, Converter={StaticResource VoiceBrush}}"
                                Visibility="{Binding Voice.HudVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource VoicePulseDot}" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding Voice.HudState, Converter={StaticResource VoiceBrush}}"
                                         Effect="{Binding Voice.HudState, Converter={StaticResource VoiceGlow}}"/>
                                <TextBlock Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Text}" Text="{Binding Voice.HudText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HeaderPill}" Cursor="Hand"
                                Background="{Binding Status.ControlState, Converter={StaticResource StateSoftBrush}}"
                                BorderBrush="{Binding Status.ControlState, Converter={StaticResource StateBrush}}"
                                MouseLeftButtonUp="ControlPill_Click" ToolTip="Switch Kinect control on or off">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Margin="0,0,7,0"
                                         Fill="{Binding Status.ControlState, Converter={StaticResource StateBrush}}"
                                         Effect="{Binding Status.ControlState, Converter={StaticResource StateGlow}}"/>
                                <TextBlock Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Text}"
                                           Text="{Binding Status.ControlStateText, StringFormat=Control {0}}"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Button.Icon}" Margin="10,0,4,0" Command="{Binding ToggleHelpCommand}"
                                ToolTip="Help drawer: what does each control do?">
                            <local:IconView Icon="{StaticResource IconHelp}" Size="17"/>
                        </Button>
                    </StackPanel>

                    <!-- Room for the caption buttons, which sit in the window's top-right corner (below). -->
                    <Border Grid.Column="2" Width="144"/>
                </Grid>

                <!-- Page host. Pages are created once and swapped; each fades in on arrival. -->
                <ContentControl Grid.Row="1" x:Name="PageHost" Margin="0" Focusable="False"/>
            </Grid>

            <!-- ============================ Help drawer ============================ -->
            <Border Grid.Column="2" x:Name="HelpDrawer" Style="{StaticResource HelpDrawerStyle}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1,0,0,0"
                    Background="{StaticResource Brush.Rail}">
                <Grid Width="340">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Row 0 is caption band: the window's caption buttons sit over its right end. -->
                    <Grid Grid.Row="1" Margin="20,0,12,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:IconView Icon="{StaticResource IconHelp}" Size="16" Margin="0,0,8,0" Foreground="{StaticResource Brush.Accent}"/>
                            <TextBlock Text="What does this do?" FontSize="13.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Right" Padding="10,5"
                                Command="{Binding CloseHelpCommand}" ToolTip="Close the help drawer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hide" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <local:IconView Icon="{StaticResource IconChevronDown}" Size="12" RenderTransformOrigin="0.5,0.5">
                                    <local:IconView.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </local:IconView.RenderTransform>
                                </local:IconView>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,4,12,20">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding HelpTitle}" Style="{StaticResource Text.CardTitle}" FontSize="16"/>
                            <TextBlock Text="{Binding HelpWhat}" Style="{StaticResource Text.BodyDim}" Margin="0,8,0,0" LineHeight="19"/>

                            <StackPanel Visibility="{Binding HasHelpScale, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="HIGHER" Style="{StaticResource HelpLabel}" Foreground="{StaticResource Brush.Accent}"/>
                                <TextBlock Text="{Binding HelpHigher}" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="LOWER" Style="{StaticResource HelpLabel}" Foreground="{StaticResource Brush.Accent}"/>
                                <TextBlock Text="{Binding HelpLower}" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="TOO HIGH FEELS LIKE" Style="{StaticResource HelpLabel}" Foreground="{StaticResource Brush.Warning}"/>
                                <TextBlock Text="{Binding HelpTooHigh}" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="TOO LOW FEELS LIKE" Style="{StaticResource HelpLabel}" Foreground="{StaticResource Brush.Warning}"/>
                                <TextBlock Text="{Binding HelpTooLow}" Style="{StaticResource Text.Body}"/>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,20,0,14"/>
                            <TextBlock Text="Hover any tuning control to read about it here. Click its ? to pin it. The full guide is under Settings."
                                       Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================ Caption buttons ============================ -->
            <!-- Always in the window's top-right corner, over the help drawer when it is open.
                 Windows' own caption buttons are switched off (WindowBackdrop.HideSystemCaptionButtons),
                 so these are the only ones. -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,10,0" Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.Caption}" Click="Minimize_Click" ToolTip="Minimize">
                    <local:IconView Icon="{StaticResource IconMinimize}" Size="14"/>
                </Button>
                <Button Style="{StaticResource Button.Caption}" Click="Maximize_Click" ToolTip="Maximize / restore">
                    <local:IconView x:Name="MaximizeGlyph" Icon="{StaticResource IconMaximize}" Size="13"/>
                </Button>
                <Button Style="{StaticResource Button.CaptionClose}" Click="Close_Click" ToolTip="Quit KINECT-OS">
                    <local:IconView Icon="{StaticResource IconClose}" Size="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
