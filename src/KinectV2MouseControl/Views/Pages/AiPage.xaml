<UserControl x:Class="KinectV2MouseControl.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,16,28,28">
            <Border Style="{StaticResource CardAccent}" Padding="24">
                <StackPanel>
                    <TextBlock Text="KINECT-OS ASSISTANT" Style="{StaticResource Text.EyebrowAccent}"/>
                    <TextBlock Text="Ask for what you need." Style="{StaticResource Text.Display}" FontSize="26" Margin="0,8,0,8"/>
                    <TextBlock Text="Speak after the chime, or type a request below. Built-in and custom commands run locally. Other requests can use DeepSeek to open apps, find files, search the web and arrange windows."
                               Style="{StaticResource Text.BodyDim}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="DEEPSEEK CONNECTION" Style="{StaticResource Text.Eyebrow}"/>
                    <TextBlock Text="API key" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                    <Border Style="{StaticResource CardInset}" Padding="8,2">
                        <PasswordBox x:Name="KeyBox" MaxLength="512" Padding="6" FontSize="16" Background="Transparent"
                                     Foreground="{StaticResource Brush.Text}" BorderThickness="0"/>
                    </Border>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="TestKeyButton" Content="Test key &amp; save" Style="{StaticResource Button.Ghost}" Click="TestKey_Click" Margin="0,0,8,6"/>
                        <Button x:Name="RemoveKeyButton" Content="Remove key" Style="{StaticResource Button.Ghost}" Command="{Binding Assistant.RemoveKeyCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Assistant.KeyStatus}" Style="{StaticResource Text.Caption}"/>
                    <TextBlock Text="Model" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                    <ComboBox x:Name="ModelBox" Style="{StaticResource ComboBox.Field}" ItemsSource="{Binding Assistant.Models}" SelectedItem="{Binding Assistant.Model, Mode=TwoWay}"/>
                    <CheckBox x:Name="OtherRequestsCheck" Content="Send other requests to AI" Style="{StaticResource Toggle}" IsChecked="{Binding Assistant.SendOtherRequests, Mode=TwoWay}" Margin="0,14,0,10"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Audio stays on this PC. DeepSeek receives the request text, display layout, foreground app, available command names and tool results. Window titles are sent only when the assistant requests a window list. Your key is encrypted for your Windows account."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="TRY A REQUEST" Style="{StaticResource Text.Eyebrow}"/>
                    <TextBlock Text="For example: open Edge and search YouTube for lo-fi study music" Style="{StaticResource Text.Caption}" Margin="0,8,0,8"/>
                    <TextBox x:Name="RequestBox" Style="{StaticResource TextBox.Field}" Text="{Binding Assistant.RequestText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="4000"/>
                    <WrapPanel Margin="0,10,0,8">
                        <Button x:Name="SendButton" Content="Run request" Style="{StaticResource Button.Ghost}" Command="{Binding Assistant.SubmitCommand}" Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.Ghost}" Command="{Binding Assistant.CancelCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Assistant.Status}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Accent}"/>
                    <TextBlock Text="STEPS" Style="{StaticResource Text.Eyebrow}" Margin="0,18,0,8"/>
                    <ItemsControl ItemsSource="{Binding Assistant.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,3"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
