<UserControl x:Class="KinectV2MouseControl.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KinectV2MouseControl">
    <UserControl.Resources>
        <Style x:Key="PlanCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="8,0,8,16"/>
        </Style>
        <Style x:Key="PlanIcon" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FlowNode" TargetType="Border" BasedOn="{StaticResource CardInset}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,16,28,28">

            <!-- ============================ Hero ============================ -->
            <Border Style="{StaticResource CardAccent}" Padding="28,26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="88" Height="88" Margin="0,0,26,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource Brush.AccentSoft}" StrokeThickness="1"/>
                        <Ellipse Width="66" Height="66" Fill="{StaticResource Brush.AccentFaint}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1" Opacity="0.8"/>
                        <local:IconView Icon="{StaticResource IconAi}" Size="34" Foreground="{StaticResource Brush.Accent}" Effect="{StaticResource Effect.AccentGlow}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KINECT-OS INTELLIGENCE" Style="{StaticResource Text.EyebrowAccent}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Pill}" Padding="8,2" Margin="10,0,0,0"
                                    Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}">
                                <TextBlock Style="{StaticResource Pill.Text}" FontSize="10" Text="PLANNED" Foreground="{StaticResource Brush.Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="An assistant that speaks the same action language as your hands." Style="{StaticResource Text.Display}" FontSize="26" Margin="0,6,0,6"/>
                        <TextBlock Style="{StaticResource Text.BodyDim}" LineHeight="20"
                                   Text="Gestures and voice already turn intent into actions through one router. The assistant layer is the third input on that router: it will take a spoken or typed request, decide which catalog actions carry it out, and run them - never anything outside the catalog, and never the pointer. This section reserves its place and shape; nothing here contacts any service yet."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Plan cards ============================ -->
            <UniformGrid Columns="2" Margin="-8,16,-8,0">
                <Border Style="{StaticResource PlanCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PlanIcon}">
                            <local:IconView Icon="{StaticResource IconChat}" Size="20" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="Assistant" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" LineHeight="17"
                                   Text="&#8220;Put this on the other screen and mute the music.&#8221; Free-form requests, from the voice page's fallback path or a text box here, resolved into one or more actions. Confirms before anything destructive."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PlanCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PlanIcon}">
                            <local:IconView Icon="{StaticResource IconCpu}" Size="20" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="Provider &amp; model" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" LineHeight="17"
                                   Text="Local-first: an on-device model where the machine can run one, with cloud providers as an explicit, off-by-default option. The choice, keys and privacy switch will live here."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PlanCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PlanIcon}">
                            <local:IconView Icon="{StaticResource IconRoute}" Size="20" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Tool access" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding Actions.AvailableCount, Mode=OneWay}"/><Run Text=" actions today"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" LineHeight="17"
                                   Text="The assistant's tools are exactly the Actions catalog - window management, media, system control, app launching - each one individually allow-listable. Adding an action for gestures or voice automatically makes it available here."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PlanCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PlanIcon}">
                            <local:IconView Icon="{StaticResource IconWorkflow}" Size="20" Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="Workflows &amp; automation" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" LineHeight="17"
                                   Text="Named routines you can trigger by voice or gesture: &#8220;focus mode&#8221; = mute, maximize, show one window; &#8220;movie mode&#8221; = play, volume up, Kinect control off. Triggers, steps and conditions, stored locally."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================ Architecture ============================ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WHERE IT PLUGS IN" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource FlowNode}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconGestures}" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.Success}"/>
                                    <TextBlock Text="Gestures" Style="{StaticResource Text.Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlowNode}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconVoice}" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="Voice" Style="{StaticResource Text.Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlowNode}" BorderBrush="{StaticResource Brush.AccentSoft}">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconAi}" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text="Assistant" Style="{StaticResource Text.Body}"/>
                                    <TextBlock Text="  planned" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <local:IconView Grid.Column="1" Icon="{StaticResource IconArrowRight}" Size="18" Margin="14,0" Foreground="{StaticResource Brush.Accent}"/>
                        <Border Grid.Column="2" Style="{StaticResource FlowNode}">
                            <StackPanel>
                                <TextBlock Text="Intent" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="ControlAction" Style="{StaticResource Text.Mono}"/>
                            </StackPanel>
                        </Border>
                        <local:IconView Grid.Column="3" Icon="{StaticResource IconArrowRight}" Size="18" Margin="14,0" Foreground="{StaticResource Brush.Accent}"/>
                        <Border Grid.Column="4" Style="{StaticResource FlowNode}">
                            <StackPanel>
                                <TextBlock Text="Router" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="ActionRouter" Style="{StaticResource Text.Mono}"/>
                            </StackPanel>
                        </Border>
                        <local:IconView Grid.Column="5" Icon="{StaticResource IconArrowRight}" Size="18" Margin="14,0" Foreground="{StaticResource Brush.Accent}"/>
                        <Border Grid.Column="6" Style="{StaticResource FlowNode}" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Windows" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="mouse &#183; keys &#183; media &#183; apps &#183; control gate" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                               Text="Deliberately out of scope for the assistant: moving the pointer (hands only, always), anything not in the catalog, and any network access unless a cloud provider is explicitly switched on."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
