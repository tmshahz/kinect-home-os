<UserControl x:Class="KinectV2MouseControl.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KinectV2MouseControl">
    <UserControl.Resources>
        <DataTemplate x:Key="SlotTemplate">
            <Border Margin="8,0" Padding="20" CornerRadius="16" BorderThickness="1"
                    Background="{Binding IsActive, Converter={StaticResource OnSoftBrush}}"
                    BorderBrush="{Binding IsActive, Converter={StaticResource OnBorderBrush}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SlotLabel}" Style="{StaticResource Text.Eyebrow}"/>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="8,2"
                                Background="{Binding IsActive, Converter={StaticResource GoodSoftBrush}}">
                            <TextBlock Style="{StaticResource Pill.Text}" FontSize="10.5" Text="{Binding StateText}"
                                       Foreground="{Binding IsActive, Converter={StaticResource PlannedBrush}}"/>
                        </Border>
                    </Grid>
                    <TextBox Grid.Row="1" Style="{StaticResource TextBox.Field}" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Click to rename. The name is saved as soon as you leave the box."/>
                    <TextBlock Grid.Row="2" Text="{Binding SavedAtText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,10"/>
                    <TextBlock Grid.Row="3" Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}" MinHeight="54"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding LoadCommand}" MinWidth="86"
                                ToolTip="Apply this slot's tuning now (buttons released, filters reset)">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Icon="{StaticResource IconDownload}" Size="14" Margin="0,0,7,0"/>
                                <TextBlock Text="Load"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding SaveCommand}" MinWidth="86" Margin="8,0,0,0"
                                ToolTip="Store the current tuning and calibration in this slot">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Icon="{StaticResource IconSave}" Size="14" Margin="0,0,7,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,16,28,28">
            <Border Style="{StaticResource CardStrong}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Brush.AccentSoft}" Margin="0,0,18,0" VerticalAlignment="Center">
                        <local:IconView Icon="{StaticResource IconProfiles}" Size="24" Foreground="{StaticResource Brush.Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE TUNING" Style="{StaticResource Text.Eyebrow}"/>
                        <TextBlock Text="{Binding Engine.ActiveProfileName}" Style="{StaticResource Text.Display}" FontSize="26"/>
                        <TextBlock Text="{Binding Engine.ProfileLastResult}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="SLOTS" Style="{StaticResource Text.Eyebrow}" Margin="0,22,0,10"/>
            <ItemsControl ItemsSource="{Binding Engine.Slots}" ItemTemplate="{StaticResource SlotTemplate}" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <UniformGrid Columns="2" Margin="-8,16,-8,0">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="HOW PROFILES WORK" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Text.BodyDim}" Margin="0,0,0,8"
                                   Text="A profile stores every tuning and calibration value: pointer feel, activation zone, stationary lock, scroll and swipe, hover, hand range and centre. It does not store the control mode or anything live."/>
                        <TextBlock Style="{StaticResource Text.BodyDim}" Margin="0,0,0,8"
                                   Text="Loading applies the values safely - any held button is released and filters, lock and pointer session restart under the new values. Changing a value afterwards marks the profile as modified until you save again."/>
                        <TextBlock Style="{StaticResource Text.BodyDim}"
                                   Text="Your last-used settings are also saved automatically when KINECT-OS closes, separately from the slots, so a profile is a snapshot you can always come back to."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="STORAGE &amp; RESET" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,8"/>
                        <TextBlock Text="Profiles are shared by the Debug and Release builds and survive rebuilds:" Style="{StaticResource Text.BodyDim}"/>
                        <TextBlock Text="{Binding Engine.ProfileFilePath}" Style="{StaticResource Text.Mono}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenLogFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconFolder}" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Danger}" Command="{Binding RestoreDefaultsCommand}" Margin="8,0,0,0"
                                    ToolTip="Reset the live tuning to the built-in defaults. Saved slots are untouched.">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconRefresh}" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Restore defaults"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
