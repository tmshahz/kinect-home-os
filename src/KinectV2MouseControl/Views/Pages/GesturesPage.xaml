<UserControl x:Class="KinectV2MouseControl.GesturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KinectV2MouseControl">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="GestureCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="GestureIconBox" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="GestureTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
            <Setter Property="Margin" Value="0,0,78,0"/>
        </Style>
        <Style x:Key="TuningGroup" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="8,0,8,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28">

            <!-- ============================ Control mode ============================ -->
            <TextBlock Text="CONTROL MODE" Style="{StaticResource SectionLabel}" Margin="0,8,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="Grip to press" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=2}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Move only" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=1}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Hover to click" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=3}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Move + grip pressing" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=4}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Move + lift clicking" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=5}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Disabled (sensor off)" GroupName="Mode"
                                     IsChecked="{Binding Engine.ControlModeIndex, Mode=TwoWay, Converter={StaticResource RadioCheckConverter}, ConverterParameter=0}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="Grip to press is the full vocabulary: pointer-hand fist to click and drag, lasso to right click, secondary-hand fist clutch for scroll and swipe. Lower the pointer hand for 0.5 s while the other hand is raised to swap roles. The double clap works in every active mode."/>
                </StackPanel>
            </Border>

            <!-- ============================ Pointer hand ============================ -->
            <TextBlock Text="{Binding Status.PointerHandName, StringFormat=POINTER HAND · {0} · CLICKS}" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="3" Margin="-8,0">
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsPointerActive, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsPointerActive, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconPointer}" Size="20" Foreground="{Binding Status.IsPointerActive, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsPointerActive, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Pointer" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsPointerActive, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.PointerSessionText}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Raise the pointer hand forward into the control zone. After a short settle it takes the cursor. To swap deliberately, lower it for 0.5 s while the other hand is fully tracked and raised; both hands up never flips roles."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsGripHeld, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsGripHeld, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconGrip}" Size="20" Foreground="{Binding Status.IsGripHeld, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsGripHeld, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Grip · click &amp; drag" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsGripHeld, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.IsGripHeld, Converter={StaticResource OnText}}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Close the pointer-hand fist to press the left button, open it to release. The cursor freezes as the fist closes so the click lands where you aimed; keep it closed to drag."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsLassoActive, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsLassoActive, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconLasso}" Size="20" Foreground="{Binding Status.IsLassoActive, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsLassoActive, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Lasso · right click" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsLassoActive, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.IsLassoActive, Converter={StaticResource OnText}}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Two fingers up (the Kinect 'lasso') held briefly = one right click. Open or close the hand to re-arm. Stands down while a drag is in progress."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================ Secondary hand ============================ -->
            <TextBlock Text="{Binding Status.SecondaryHandName, StringFormat=SECONDARY HAND · {0} · CLUTCH GESTURES}" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="3" Margin="-8,0">
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsClutchArmed, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsClutchArmed, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconClutch}" Size="20" Foreground="{Binding Status.IsClutchArmed, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsClutchArmed, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Clutch" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsClutchArmed, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.ClutchText}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Close the secondary-hand fist inside the control zone to arm. An open secondary hand does nothing. Opening the fist ends scrolling or swiping at once."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsScrolling, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsScrolling, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconScroll}" Size="20" Foreground="{Binding Status.IsScrolling, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsScrolling, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Clutch + vertical · scroll" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsScrolling, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.IsScrolling, Converter={StaticResource OnText}}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Hold the closed fist still for a moment to set neutral, then raise it to scroll up or lower it to scroll down. Further from neutral scrolls faster; the curve keeps small offsets gentle."/>
                        <TextBlock Style="{StaticResource Text.Mono}" Margin="0,8,0,0" Text="{Binding Status.ScrollText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsSwiping, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsSwiping, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconSwipe}" Size="20" Foreground="{Binding Status.IsSwiping, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsSwiping, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Clutch + horizontal · switch window" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsSwiping, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.IsSwiping, Converter={StaticResource OnText}}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Sweep the closed fist quickly sideways: right = next window, left = previous window (Alt+Tab). A one-second cooldown lets you bring the hand back without switching again."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================ Global ============================ -->
            <TextBlock Text="GLOBAL" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="3" Margin="-8,0">
                <Border Style="{StaticResource GestureCard}" BorderBrush="{Binding Status.IsClapArmed, Converter={StaticResource OnBorderBrush}}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{Binding Status.IsClapArmed, Converter={StaticResource OnSoftBrush}}">
                            <local:IconView Icon="{StaticResource IconClap}" Size="20" Foreground="{Binding Status.IsClapArmed, Converter={StaticResource OnBrush}}"
                                            Effect="{Binding Status.IsClapArmed, Converter={StaticResource OnGlow}}"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="Double clap · control on / off" Style="{StaticResource GestureTitle}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2"
                                    Background="{Binding Status.IsClapArmed, Converter={StaticResource GoodSoftBrush}}">
                                <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Status.ClapText}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Two quick claps toggle Kinect control. Tracking keeps running while off, so a second double clap brings it back; a drag in progress is released safely."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{StaticResource Brush.NeutralSoft}">
                            <local:IconView Icon="{StaticResource IconHover}" Size="20" Foreground="{StaticResource Brush.TextDim}"/>
                        </Border>
                        <TextBlock Text="Hover to click" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Hover to click mode only: hold the cursor still for the hover duration to click. Range and duration are tuned below."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GestureCard}">
                    <StackPanel>
                        <Border Style="{StaticResource GestureIconBox}" Background="{StaticResource Brush.NeutralSoft}">
                            <local:IconView Icon="{StaticResource IconShield}" Size="20" Foreground="{StaticResource Brush.TextDim}"/>
                        </Border>
                        <TextBlock Text="Fail-safes" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Tracking loss, sensor disconnect, a frame stall, mode change, calibration, profile load or closing the app all release any held button and hand the cursor back to the mouse."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================ Advanced tuning ============================ -->
            <Grid Margin="0,26,0,12">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource ChipToggle}">
                        <StackPanel Orientation="Horizontal">
                            <local:IconView Icon="{StaticResource IconSettings}" Size="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Advanced tuning"/>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="Every engine value, grouped by feel. Hover a control (or click its ?) for what it does."/>
                </StackPanel>
                <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Right" Command="{Binding RestoreDefaultsCommand}"
                        Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <local:IconView Icon="{StaticResource IconRefresh}" Size="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Restore defaults"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="2" Margin="-8,0">
                    <Border Style="{StaticResource TuningGroup}">
                        <StackPanel>
                            <TextBlock Text="POINTER FEEL" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,6"/>
                            <local:TuningSlider Label="Movement scale" Unit="×" Minimum="0.1" Maximum="6" SmallChange="0.05" LargeChange="0.5" Value="{Binding Engine.MoveScale}"/>
                            <local:TuningSlider Label="Cursor smoothing" Minimum="0" Maximum="0.95" SmallChange="0.01" LargeChange="0.1" Value="{Binding Engine.Smoothing}"/>
                            <local:TuningSlider Label="Speed responsiveness" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Engine.SpeedResponsiveness}"/>
                            <local:TuningSlider Label="Jitter dead zone" Unit="px" HelpKey="Jitter dead zone (px)" Minimum="0" Maximum="20" SmallChange="0.5" LargeChange="2" Value="{Binding Engine.JitterDeadzone}"/>
                            <local:TuningSlider Label="Pointer settle" Unit="s" HelpKey="Pointer settle (s)" Minimum="0.05" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Engine.PointerSettleTime}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TuningGroup}">
                        <StackPanel>
                            <TextBlock Text="STATIONARY LOCK" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StationaryLockCheck" Style="{StaticResource Toggle}" Content="Stationary lock"
                                      IsChecked="{Binding Engine.StationaryLockEnabled, Mode=TwoWay}" Margin="0,0,0,8"/>
                            <local:TuningSlider Label="Lock radius" Unit="px" HelpKey="Lock radius (px)" Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" Value="{Binding Engine.StationaryLockRadius}"/>
                            <local:TuningSlider Label="Lock dwell" Unit="s" HelpKey="Lock dwell (s)" Minimum="0.05" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="{Binding Engine.StationaryLockDwell}"/>
                            <local:TuningSlider Label="Breakout radius" Unit="px" HelpKey="Breakout radius (px)" Minimum="5" Maximum="150" SmallChange="1" LargeChange="10" Value="{Binding Engine.StationaryBreakoutRadius}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TuningGroup}">
                        <StackPanel>
                            <TextBlock Text="ACTIVATION ZONE" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,6"/>
                            <local:TuningSlider Label="Pointer height" Unit="m" HelpKey="Pointer height (m)" Minimum="0.2" Maximum="0.9" SmallChange="0.01" LargeChange="0.05" Value="{Binding Engine.PointerCenterHeight}"/>
                            <local:TuningSlider Label="Activation height" Unit="m" HelpKey="Activation height (m)" Minimum="0" Maximum="0.7" SmallChange="0.01" LargeChange="0.05" Value="{Binding Engine.ActivationMinHeight}"/>
                            <local:TuningSlider Label="Forward activation" Unit="m" HelpKey="Forward activation (m)" Minimum="0.02" Maximum="0.4" SmallChange="0.01" LargeChange="0.05" Value="{Binding Engine.ForwardActivationDistance}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       Text="The Displays page draws these thresholds against your live hand position."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TuningGroup}">
                        <StackPanel>
                            <TextBlock Text="CLICKING" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,6"/>
                            <local:TuningSlider Label="Click freeze" Unit="s" HelpKey="Click freeze (s)" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05" Value="{Binding Engine.ClickFreezeDuration}"/>
                            <local:TuningSlider Label="Hover-to-click range" Unit="px" Minimum="5" Maximum="150" SmallChange="1" LargeChange="10" Value="{Binding Engine.HoverRange}"/>
                            <local:TuningSlider Label="Hover-to-click duration" Unit="s" Minimum="0.3" Maximum="5" SmallChange="0.1" LargeChange="0.5" Value="{Binding Engine.HoverDuration}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TuningGroup}">
                        <StackPanel>
                            <TextBlock Text="SCROLL &amp; SWIPE" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,6"/>
                            <local:TuningSlider Label="Scroll speed" Minimum="10" Maximum="200" SmallChange="5" LargeChange="20" Value="{Binding Engine.ScrollSpeed}"/>
                            <local:TuningSlider Label="Scroll curve" Minimum="1" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding Engine.ScrollCurve}"/>
                            <CheckBox x:Name="InvertScrollCheck" Style="{StaticResource Toggle}" Content="Invert scroll"
                                      IsChecked="{Binding Engine.InvertScroll, Mode=TwoWay}" Margin="0,6,0,10"/>
                            <local:TuningSlider Label="Swipe distance" Unit="m" HelpKey="Swipe distance (m)" Minimum="0.1" Maximum="0.6" SmallChange="0.01" LargeChange="0.05" Value="{Binding Engine.SwipeMinDisplacement}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TuningGroup}" Background="{StaticResource Brush.AccentFaint}" BorderBrush="{StaticResource Brush.AccentSoft}">
                        <StackPanel>
                            <TextBlock Text="REACH &amp; CALIBRATION" Style="{StaticResource Text.EyebrowAccent}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Text.BodyDim}"
                                       Text="Hand range, hand centre and the guided five-point calibration live on the Displays page, next to the picture of your desktop and hand space."/>
                            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="Displays">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconView Icon="{StaticResource IconDisplays}" Size="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open spatial setup"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
