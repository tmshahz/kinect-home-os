<UserControl x:Class="KinectV2MouseControl.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KinectV2MouseControl">
    <UserControl.Resources>
        <Style x:Key="MicPulse" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="MicPulseStory">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.9" Duration="0:0:1.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.9" Duration="0:0:1.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="MicPulseStory"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CommandTemplate">
            <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Phrase, StringFormat=&#8220;{0}&#8221;}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{Binding IsAvailable, Converter={StaticResource OnBrush}}"/>
                        <TextBlock Text="{Binding AliasText}" Style="{StaticResource Text.Caption}" FontSize="11"
                                   Visibility="{Binding AliasText, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0"/>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="8,2"
                            Background="{Binding IsAvailable, Converter={StaticResource PlannedSoftBrush}}">
                        <TextBlock Style="{StaticResource Pill.Text}" FontSize="10.5" Text="{Binding StatusText}"
                                   Foreground="{Binding IsAvailable, Converter={StaticResource PlannedBrush}}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommandGroupTemplate">
            <StackPanel Margin="0,0,0,18">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.EyebrowAccent}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource CommandTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,16,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ Engine & mic ============================ -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Style="{StaticResource CardStrong}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LOCAL VOICE ENGINE" Style="{StaticResource Text.Eyebrow}"/>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="8,2"
                                    Background="{StaticResource Brush.AccentFaint}" BorderBrush="{StaticResource Brush.AccentSoft}">
                                <TextBlock Style="{StaticResource Pill.Text}" FontSize="10" Text="BETA" Foreground="{StaticResource Brush.Accent}"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="72" Height="72" Margin="0,0,20,0">
                                <Ellipse Style="{StaticResource MicPulse}" Fill="{StaticResource Brush.Accent}"/>
                                <Ellipse Width="60" Height="60" Fill="{Binding Voice.IsListening, Converter={StaticResource OnSoftBrush}}"
                                         Stroke="{Binding Voice.IsListening, Converter={StaticResource OnBorderBrush}}" StrokeThickness="1"/>
                                <local:IconView Icon="{StaticResource IconVoice}" Size="26"
                                                Foreground="{Binding Voice.IsListening, Converter={StaticResource OnBrush}}"
                                                Effect="{Binding Voice.IsHearingSpeech, Converter={StaticResource OnGlow}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Voice.StatusText}" Style="{StaticResource Text.Display}" FontSize="26"/>
                                <TextBlock Text="{Binding Voice.BackendText}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                <CheckBox x:Name="VoiceToggle" Style="{StaticResource Toggle}" Content="Voice commands" Margin="0,12,0,0"
                                          IsChecked="{Binding Voice.IsEnabled, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardInset}" Margin="0,16,0,0"
                                Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.Danger}"
                                Visibility="{Binding Voice.HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Voice.ErrorText}" Style="{StaticResource Text.Body}"/>
                        </Border>

                        <Border Style="{StaticResource CardInset}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="LAST HEARD" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBlock Text="{Binding Voice.LastHeardText}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Voice.LastHeardDetail}" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                                   Text="Recognition runs on this PC through the Windows speech recognizer with a closed grammar of the phrases listed here. Nothing is sent anywhere. Recognized commands go through the same action router as gestures."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="WAKE WORD" Style="{StaticResource Text.Eyebrow}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WakeWordBox" Style="{StaticResource TextBox.Field}"
                                     Text="{Binding Voice.WakeWord, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="WakeWordBox_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="{Binding Voice.WakeWordExample}" Style="{StaticResource Text.BodyDim}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                   Text="Said before every command. Leave it empty to accept bare commands, at the cost of more false triggers from normal conversation."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MICROPHONE" Style="{StaticResource Text.Eyebrow}"/>
                            <Button Style="{StaticResource Button.Help}" HorizontalAlignment="Right" Command="{Binding Voice.RefreshMicrophonesCommand}" ToolTip="Refresh the device list">
                                <local:IconView Icon="{StaticResource IconRefresh}" Size="14"/>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Style="{StaticResource Dot}" Margin="0,0,8,0" Fill="{Binding Voice.HasMicrophone, Converter={StaticResource GoodBrush}}"/>
                            <TextBlock Text="{Binding Voice.MicrophoneSummary}" Style="{StaticResource Text.Body}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Voice.MicrophoneList}" Style="{StaticResource Text.Mono}" Margin="16,6,0,0"
                                   Visibility="{Binding Voice.MicrophoneList, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                   Text="The Windows default input device is used. The Kinect's microphone array works, but on some Windows 11 machines its audio enhancements make the sensor reconnect repeatedly; if 'Kinect unavailable' starts appearing in the activity feed after enabling voice, switch the default microphone or disable the enhancements."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ Commands ============================ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="COMMANDS" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                    <Run Text="{Binding Voice.AvailableCount, Mode=OneWay}"/><Run Text=" built in"/>
                                    <Run Text=" &#183; "/><Run Text="{Binding Voice.PlannedCount, Mode=OneWay}"/><Run Text=" planned"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Voice.WakeWordExample}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Voice.Groups}" ItemTemplate="{StaticResource CommandGroupTemplate}"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="-8,16,-8,0">
                    <Border Style="{StaticResource CardAccent}" Margin="8,0">
                        <StackPanel>
                            <local:IconView Icon="{StaticResource IconSettings}" Size="18" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBlock Text="Custom commands" Style="{StaticResource Text.CardTitle}"/>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="8,2">
                                    <TextBlock Style="{StaticResource Pill.Text}" FontSize="10.5" Text="Planned"/>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="Your own phrases bound to any catalog action, including Launch app with a target. Stored locally next to your profiles; the command model already carries a Custom source for them."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardAccent}" Margin="8,0">
                        <StackPanel>
                            <local:IconView Icon="{StaticResource IconAi}" Size="18" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBlock Text="Assistant-routed" Style="{StaticResource Text.CardTitle}"/>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="8,2">
                                    <TextBlock Style="{StaticResource Pill.Text}" FontSize="10.5" Text="Planned"/>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="Anything the fixed grammar does not recognize can be handed to the assistant, which picks actions from the same catalog. See the AI section."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
